# 《记忆剧场》本地配置样例（复制为 .env 后由脚本自动生成，这里只列字段）
# 真���密钥请不要提交到仓库；scripts/configure-local.py 会把真实值写进被忽略的 .env。

# Dify 服务地址（Console 与 Service API 同源）
DIFY_BASE_URL=http://127.0.0.1:5001
# 由 scripts/configure-local.py 创建的应用 API Key（app-...）
DIFY_API_KEY=app-REPLACE_ME
# 导入 DSL 后拿到的应用 ID
DIFY_APP_ID=
# Dify 直连的 PowerContext 地址（不带 /v1 后缀）
POWERCONTEXT_URL=http://127.0.0.1:8124
# 网页入口端口
PORT=8787
