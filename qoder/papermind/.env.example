# ---------- 模型服务（阿里云 DashScope，OpenAI 兼容协议）----------
# 必填：控制台 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-replace-with-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

CHAT_MODEL=qwen-plus
# dashscope: 用通义 text-embedding-v3（需要 Key，语义效果最好）
# local:     本地哈希向量，零凭据，只按字面相似度召回，用于离线演示与自测
EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
LOCAL_EMBEDDING_DIM=384

# ---------- seekdb ----------
# embedded: 零依赖，仅 Linux / macOS 可用（Windows 请用 server 模式）
# server:   连接 seekdb Server / Docker / OceanBase（MySQL 协议）
# 注意：WSL 下代码在 /mnt/c 或 /mnt/d 时，嵌入式数据目录必须放到 Linux 原生路径，
#       例如 /home/<user>/.papermind/data（见 DATA_DIR / SEEKDB_PATH）。
SEEKDB_MODE=embedded
SEEKDB_PATH=./data/seekdb
SEEKDB_DATABASE=papermind
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=

# 集合名
SEEKDB_DOC_COLLECTION=docs
SEEKDB_CHUNK_COLLECTION=chunks

# ---------- PowerContext ----------
# 先启动 PowerContext Server（默认端口 8123，见 config/powercontext.env.example）
POWERCONTEXT_URL=http://127.0.0.1:8123
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE_PREFIX=papermind

# ---------- 应用 ----------
APP_HOST=127.0.0.1
APP_PORT=8080
DATA_DIR=./data
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=6
RETRIEVE_CANDIDATES=24
