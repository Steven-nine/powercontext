# sddctx 配置示例（全部为占位值，请勿提交真实凭据）
# 复制为 .env 后按实际环境填写，或直接导出为环境变量。

# ---- MiniMax（中国大陆站）----
# Key 在 https://platform.minimax.cn/user-center/basic-information/interface-key 创建
MINIMAX_API_KEY=sk-REPLACE_WITH_YOUR_MINIMAX_KEY
SDDCTX_MINIMAX_BASE_URL=https://api.minimax.cn/v1
SDDCTX_MINIMAX_MODEL=MiniMax-M3.1-Flash
SDDCTX_MINIMAX_MAX_TOKENS=32768

# ---- seekdb / OceanBase 资料库 ----
SDDCTX_DB_HOST=127.0.0.1
SDDCTX_DB_PORT=2881
SDDCTX_DB_USER=root
SDDCTX_DB_PASSWORD=
SDDCTX_DB_NAME=sdd_ctx

# ---- 缓存与状态目录（Windows 默认落在 D 盘）----
# SDDCTX_CACHE_DIR=D:\DeepSeek缓存\minimax-sdd
# SDDCTX_STATE_DB=D:\DeepSeek缓存\minimax-sdd\state\powercontext.db
# SDDCTX_ARTIFACTS_DIR=./artifacts
# SDDCTX_LOGS_DIR=./artifacts/logs
