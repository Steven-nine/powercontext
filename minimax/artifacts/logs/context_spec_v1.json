  "code": [
    {
      "kind": "code",
      "id": "shipping_fee",
      "title": "function shipping_fee",
      "source": {
        "path": "business/shopcalc/pricing.py",
        "exists": true
      },
      "score": 54.418,
      "detail": "shipping_fee(order)",
      "signature": "shipping_fee(order)",
      "symbol_kind": "function",
      "line_start": 36,
      "line_end": 44,
      "cited_specs": [
        "SPEC-SHIP-001"
      ],
      "task_targeted": false,
      "content": "def shipping_fee(order: Order) -> Decimal:\n    \"\"\"按 SPEC-SHIP-001 计算运费。\n\n    优惠后商品金额达到免运费门槛时运费为 0，否则收取普通地区运费。\n    \"\"\"\n\n    if discounted_subtotal(order) >= FREE_SHIPPING_THRESHOLD:\n        return ZERO\n    return STANDARD_SHIPPING_FEE"
    },
    {
      "kind": "code",
      "id": "apply_coupon",
      "title": "function apply_coupon",
      "source": {
        "path": "business/shopcalc/discounts.py",
        "exists": true
      },
      "score": 43.3882,
      "detail": "apply_coupon(subtotal, coupon)",
      "signature": "apply_coupon(subtotal, coupon)",
      "symbol_kind": "function",
      "line_start": 22,
      "line_end": 38,
      "cited_specs": [
        "SPEC-CPN-001"
      ],
      "task_targeted": false,
      "content": "def apply_coupon(subtotal: Decimal, coupon: Coupon | None) -> Decimal:\n    \"\"\"按 SPEC-CPN-001 计算优惠券后的商品金额。\n\n    - 优惠券门槛未达成时，商品金额保持不变；\n    - ``percent_off`` 为百分比折扣（``0.2`` 表示减免 20%）；\n    - ``amount_off`` 为固定减免金额，在百分比折扣之后计算；\n    - 结果不小于 0。\n    \"\"\"\n\n    if coupon is None or not coupon.is_applicable(subtotal):\n        return subtotal\n    total = subtotal\n    if coupon.percent_off > ZERO:\n        total = total * (ONE - coupon.percent_off)\n    if coupon.amount_off > ZERO:\n        total = total - coupon.amount_off\n    return max(total, ZERO)"
    },
    {
      "kind": "code",
      "id": "total",
      "title": "function total",
      "source": {
        "path": "business/shopcalc/pricing.py",
        "exists": true
      },
      "score": 42.918,
      "detail": "total(order)",
      "signature": "total(order)",
      "symbol_kind": "function",
      "line_start": 47,
      "line_end": 50,
      "cited_specs": [],
      "task_targeted": false,
      "content": "def total(order: Order) -> Decimal:\n    \"\"\"订单应付金额 = 优惠后商品金额 + 运费。\"\"\"\n\n    return discounted_subtotal(order) + shipping_fee(order)"
    },
    {
      "kind": "code",
      "id": "discounted_subtotal",
      "title": "function discounted_subtotal",
      "source": {
        "path": "business/shopcalc/pricing.py",
        "exists": true
      },
      "score": 40.418,
      "detail": "discounted_subtotal(order)",
      "signature": "discounted_subtotal(order)",
      "symbol_kind": "function",
      "line_start": 28,
      "line_end": 33,
      "cited_specs": [
        "SPEC-CPN-001",
        "SPEC-MEM-001"
      ],
      "task_targeted": false,
      "content": "def discounted_subtotal(order: Order) -> Decimal:\n    \"\"\"优惠后商品金额：先优惠券（SPEC-CPN-001），再会员折扣（SPEC-MEM-001）。\"\"\"\n\n    total = apply_coupon(subtotal(order), order.coupon)\n    total = total * member_rate(order.member_level)\n    return total.quantize(CENT)"
    },
    {
      "kind": "code",
      "id": "subtotal",
      "title": "function subtotal",
      "source": {
        "path": "business/shopcalc/pricing.py",
        "exists": true
      },
      "score": 40.418,
      "detail": "subtotal(order)",
      "signature": "subtotal(order)",
      "symbol_kind": "function",
      "line_start": 22,
      "line_end": 25,
      "cited_specs": [],
      "task_targeted": false,
      "content": "def subtotal(order: Order) -> Decimal:\n    \"\"\"订单商品小计（未优惠）。\"\"\"\n\n    return sum((item.line_total for item in order.items), ZERO)"
    },
    {
      "kind": "code",
      "id": "member_rate",
      "title": "function member_rate",
      "source": {
        "path": "business/shopcalc/discounts.py",
        "exists": true
      },
      "score": 40.3882,
      "detail": "member_rate(member_level)",
      "signature": "member_rate(member_level)",
      "symbol_kind": "function",
      "line_start": 41,
      "line_end": 44,
      "cited_specs": [
        "SPEC-MEM-001"
      ],
      "task_targeted": false,
      "content": "def member_rate(member_level: str) -> Decimal:\n    \"\"\"返回会员等级折扣率；普通会员返回 1（SPEC-MEM-001）。\"\"\"\n\n    return MEMBER_DISCOUNTS.get(member_level, ONE)"
    },
    {
      "kind": "code",
      "id": "Coupon",
      "title": "class Coupon",
      "source": {
        "path": "business/shopcalc/models.py",
        "exists": true
      },
      "score": 24.7432,
      "detail": "class Coupon",
      "signature": "class Coupon",
      "symbol_kind": "class",
      "line_start": 31,
      "line_end": 42,
      "cited_specs": [],
      "task_targeted": false,
      "content": "class Coupon:\n    \"\"\"优惠券：满减、折扣或二者组合。\"\"\"\n\n    code: str\n    amount_off: Decimal = ZERO\n    percent_off: Decimal = ZERO\n    min_subtotal: Decimal = ZERO\n\n    def is_applicable(self, subtotal: Decimal) -> bool:\n        \"\"\"门槛判断：商品金额达到 ``min_subtotal`` 时优惠券才可使用。\"\"\"\n\n        return subtotal >= self.min_subtotal"
    },
    {
      "kind": "code",
      "id": "Order",
      "title": "class Order",
      "source": {
        "path": "business/shopcalc/models.py",
        "exists": true
      },
      "score": 24.7432,
      "detail": "class Order",
      "signature": "class Order",
      "symbol_kind": "class",
      "line_start": 46,
      "line_end": 53,
      "cited_specs": [],
      "task_targeted": false,
      "content": "class Order:\n    \"\"\"订单聚合根。\"\"\"\n\n    order_id: str\n    items: tuple[OrderItem, ...] = ()\n    region: str = \"\"\n    coupon: Coupon | None = None\n    member_level: str = \"normal\""
    },
    {
      "kind": "code",
      "id": "OrderItem",
      "title": "class OrderItem",
      "source": {
        "path": "business/shopcalc/models.py",
        "exists": true
      },
      "score": 24.7432,
      "detail": "class OrderItem",
      "signature": "class OrderItem",
      "symbol_kind": "class",
      "line_start": 12,
      "line_end": 27,
      "cited_specs": [],
      "task_targeted": false,
      "content": "class OrderItem:\n    \"\"\"订单行：单价与数量。\"\"\"\n\n    sku: str\n    unit_price: Decimal\n    quantity: int\n\n    def __post_init__(self) -> None:\n        if self.quantity < 0:\n            raise ValueError(\"quantity must not be negative\")\n        if self.unit_price < ZERO:\n            raise ValueError(\"unit_price must not be negative\")\n\n    @property\n    def line_total(self) -> Decimal:\n        return self.unit_price * self.quantity"
    },
    {
      "kind": "code",
      "id": "Coupon.is_applicable",
      "title": "method Coupon.is_applicable",
      "source": {
        "path": "business/shopcalc/models.py",
        "exists": true
      },
      "score": 24.2432,
      "detail": "Coupon.is_applicable(self, subtotal)",
      "signature": "Coupon.is_applicable(self, subtotal)",
      "symbol_kind": "method",
      "line_start": 39,
      "line_end": 42,
      "cited_specs": [],
      "task_targeted": false,
      "content": "    def is_applicable(self, subtotal: Decimal) -> bool:\n        \"\"\"门槛判断：商品金额达到 ``min_subtotal`` 时优惠券才可使用。\"\"\"\n\n        return subtotal >= self.min_subtotal"
    }
